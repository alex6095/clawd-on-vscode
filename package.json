{
  "name": "clawd-on-vscode",
  "displayName": "Clawd on VS Code",
  "description": "A whimsical Clawd sidebar pet that reacts to coding-agent activity in local and Remote-SSH VS Code workspaces.",
  "version": "0.2.2",
  "icon": "resources/icons/app_icon.png",
  "author": {
    "name": "alex6095",
    "url": "https://github.com/alex6095"
  },
  "publisher": "alex6095",
  "license": "MIT",
  "homepage": "https://github.com/alex6095/clawd-on-vscode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/alex6095/clawd-on-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/alex6095/clawd-on-vscode/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "clawd",
    "vscode",
    "sidebar",
    "pet",
    "agent",
    "coding-agent",
    "claude",
    "codex",
    "gemini",
    "opencode",
    "remote-ssh"
  ],
  "galleryBanner": {
    "color": "#1f2430",
    "theme": "dark"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:clawd.petView",
    "onCommand:clawd.open",
    "onCommand:clawd.installIntegrations",
    "onCommand:clawd.toggleDnd",
    "onCommand:clawd.setTheme",
    "onCommand:clawd.restartRuntime",
    "onCommand:clawd.pauseRuntime",
    "onCommand:clawd.resumeRuntime",
    "onCommand:clawd.disableIntegrations",
    "onCommand:clawd.enableIntegrations"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "check": "node scripts/check-syntax.js",
    "test": "node --test test/*.test.js",
    "package": "vsce package --allow-missing-repository",
    "vscode:prepublish": "npm run check",
    "test:vscode": "node scripts/vscode-smoke.js"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "clawd",
          "title": "Clawd",
          "icon": "media/clawd-activity-icon.svg"
        }
      ]
    },
    "views": {
      "clawd": [
        {
          "type": "webview",
          "id": "clawd.petView",
          "name": "Clawd",
          "icon": "media/clawd-activity-icon.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "clawd.setTheme",
          "when": "view == clawd.petView",
          "group": "navigation@1"
        },
        {
          "command": "clawd.pauseRuntime",
          "when": "view == clawd.petView && !clawd.runtime.paused && clawd.integrations.enabled",
          "group": "navigation@2"
        },
        {
          "command": "clawd.resumeRuntime",
          "when": "view == clawd.petView && (clawd.runtime.paused || !clawd.integrations.enabled)",
          "group": "navigation@2"
        },
        {
          "command": "clawd.muteNotifications",
          "when": "view == clawd.petView && !clawd.dnd",
          "group": "1_activity@1"
        },
        {
          "command": "clawd.unmuteNotifications",
          "when": "view == clawd.petView && clawd.dnd",
          "group": "1_activity@1"
        },
        {
          "command": "clawd.previewAnimation",
          "when": "view == clawd.petView",
          "group": "2_character@1"
        },
        {
          "command": "clawd.installIntegrations",
          "when": "view == clawd.petView",
          "group": "3_connections@1"
        },
        {
          "command": "clawd.showConnectionHelp",
          "when": "view == clawd.petView",
          "group": "3_connections@2"
        },
        {
          "command": "clawd.restartRuntime",
          "when": "view == clawd.petView",
          "group": "4_troubleshooting@1"
        },
        {
          "command": "clawd.showDiagnostics",
          "when": "view == clawd.petView",
          "group": "4_troubleshooting@2"
        },
        {
          "command": "clawd.uninstallIntegrations",
          "when": "view == clawd.petView",
          "group": "4_troubleshooting@3"
        }
      ],
      "commandPalette": [
        {
          "command": "clawd.disableIntegrations",
          "when": "false"
        },
        {
          "command": "clawd.enableIntegrations",
          "when": "false"
        },
        {
          "command": "clawd.toggleDnd",
          "when": "false"
        },
        {
          "command": "clawd.pauseRuntime",
          "when": "!clawd.runtime.paused && clawd.integrations.enabled"
        },
        {
          "command": "clawd.resumeRuntime",
          "when": "clawd.runtime.paused || !clawd.integrations.enabled"
        },
        {
          "command": "clawd.muteNotifications",
          "when": "!clawd.dnd"
        },
        {
          "command": "clawd.unmuteNotifications",
          "when": "clawd.dnd"
        }
      ]
    },
    "commands": [
      {
        "command": "clawd.open",
        "title": "Open Clawd",
        "category": "Clawd",
        "icon": "$(heart)"
      },
      {
        "command": "clawd.installIntegrations",
        "title": "Set Up Agent Connections…",
        "category": "Clawd",
        "icon": "$(plug)"
      },
      {
        "command": "clawd.toggleDnd",
        "title": "Toggle Do Not Disturb",
        "category": "Clawd",
        "icon": "$(bell-slash)"
      },
      {
        "command": "clawd.setTheme",
        "title": "Choose Character…",
        "category": "Clawd",
        "icon": "$(smiley)"
      },
      {
        "command": "clawd.restartRuntime",
        "title": "Restart Clawd",
        "category": "Clawd",
        "icon": "$(debug-restart)"
      },
      {
        "command": "clawd.pauseRuntime",
        "title": "Pause Clawd",
        "category": "Clawd",
        "icon": "$(debug-pause)"
      },
      {
        "command": "clawd.resumeRuntime",
        "title": "Resume Clawd",
        "category": "Clawd",
        "icon": "$(debug-start)"
      },
      {
        "command": "clawd.disableIntegrations",
        "title": "Disable Agent Integrations",
        "category": "Clawd",
        "icon": "$(plug-filled)"
      },
      {
        "command": "clawd.enableIntegrations",
        "title": "Enable Agent Integrations",
        "category": "Clawd",
        "icon": "$(plug)"
      },
      {
        "command": "clawd.previewAnimation",
        "title": "Preview Animation…",
        "category": "Clawd",
        "icon": "$(play)"
      },
      {
        "command": "clawd.showDiagnostics",
        "title": "Open Diagnostics",
        "category": "Clawd",
        "icon": "$(output)"
      },
      {
        "command": "clawd.uninstallIntegrations",
        "title": "Remove Agent Connections…",
        "category": "Clawd",
        "icon": "$(trash)"
      },
      {
        "command": "clawd.muteNotifications",
        "title": "Quiet Notifications",
        "category": "Clawd",
        "icon": "$(bell-slash)"
      },
      {
        "command": "clawd.unmuteNotifications",
        "title": "Turn Notifications On",
        "category": "Clawd",
        "icon": "$(bell)"
      },
      {
        "command": "clawd.showConnectionHelp",
        "title": "Agent Connection Status…",
        "category": "Clawd",
        "icon": "$(info)"
      }
    ],
    "configuration": {
      "title": "Clawd",
      "properties": {
        "clawd.theme": {
          "type": "string",
          "default": "clawd",
          "enum": [
            "clawd",
            "calico",
            "neobjuk"
          ],
          "description": "The Clawd pet theme shown in the sidebar.",
          "enumDescriptions": [
            "Clawd",
            "Calico",
            "KAIST Neobjuk (넙죽이)"
          ]
        },
        "clawd.autoStartRuntime": {
          "type": "boolean",
          "default": true,
          "description": "Start the Clawd state server when the extension activates."
        },
        "clawd.runtime.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Allow Clawd to run its local state server and log monitors."
        },
        "clawd.integrations.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable selected agent connections. Use Set Up Agent Connections to install hooks."
        },
        "clawd.sound.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Play Clawd notification sounds in the webview."
        },
        "clawd.integrations.agents": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "claude-code",
              "codex",
              "gemini-cli",
              "cursor-agent",
              "codebuddy",
              "kiro-cli",
              "opencode"
            ]
          },
          "default": [
            "claude-code",
            "codex"
          ],
          "uniqueItems": true,
          "description": "Agents to monitor and offer in the hook installer."
        },
        "clawd.codex.logFallback": {
          "type": "boolean",
          "default": true,
          "description": "Observe local Codex logs when native hooks have not been seen. Logs never infer approval requests."
        },
        "clawd.sessions.scope": {
          "type": "string",
          "enum": [
            "workspace",
            "all"
          ],
          "default": "workspace",
          "description": "Filter observed session logs to this workspace or all local sessions. Native hooks always route to their matching window; an empty window receives unmatched hooks."
        },
        "clawd.animation.reducedMotion": {
          "type": "string",
          "enum": [
            "system",
            "on",
            "off"
          ],
          "default": "system",
          "description": "Reduce movement and honor system accessibility preferences."
        }
      }
    }
  },
  "dependencies": {
    "dom-serializer": "2.0.0",
    "htmlparser2": "10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@vscode/vsce": "^3.6.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Clawd starts local hook listeners and reads agent session logs. Open a trusted workspace to enable it."
    },
    "virtualWorkspaces": false
  }
}
